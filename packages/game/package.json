{
  "name": "@softmax-universe/reversi-game",
  "version": "0.3.0",
  "description": "The pinned Reversi engine adapter and deterministic reference policies.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@softmax-universe/protocol": "https://github.com/softmax-universe/universe/releases/download/v0.6.0-alpha.2/softmax-universe-protocol-0.6.0-alpha.2.tgz",
    "reversi": "3.0.0"
  }
}
