{
  "name": "@softmax-universe/reversi-environment",
  "version": "0.4.1",
  "private": true,
  "description": "An independent Reversi game that records and benchmarks play with Softmax Universe.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "universe-environment build",
    "type-check": "pnpm --filter @softmax-universe/reversi-game build && tsc -p tsconfig.json --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm contracts:check && pnpm format:check && pnpm build && pnpm lint && pnpm architecture:check && pnpm type-check && pnpm test",
    "play": "universe-local start",
    "benchmark": "node --import tsx app/benchmarks/command.ts",
    "universe": "universe",
    "build:app": "universe-environment build",
    "harbor:prepare": "node scripts/prepare-harbor.mjs",
    "harbor:verify": "node --import tsx app/benchmarks/harbor.ts",
    "local": "universe-local",
    "package:local": "universe-environment assemble",
    "package:game": "pnpm --filter @softmax-universe/reversi-game pack --pack-destination ./dist",
    "package:container": "node scripts/container.mjs",
    "architecture:setup": "npm --prefix .contracts/008-code-dependency-boundaries/assets/npm ci --ignore-scripts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@softmax-universe/console": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-console-0.7.0-alpha.2.tgz",
    "@softmax-universe/distribution": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-distribution-0.7.0-alpha.2.tgz",
    "@softmax-universe/inspector": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-inspector-0.7.0-alpha.2.tgz",
    "@softmax-universe/installation": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-installation-0.7.0-alpha.2.tgz",
    "@softmax-universe/local-cli": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-local-cli-0.7.0-alpha.2.tgz",
    "@softmax-universe/protocol": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-protocol-0.7.0-alpha.2.tgz",
    "@softmax-universe/reversi-game": "workspace:*",
    "@softmax-universe/runner": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-runner-0.7.0-alpha.2.tgz",
    "@softmax-universe/runtime": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-runtime-0.7.0-alpha.2.tgz",
    "@softmax-universe/runtime-client": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-runtime-client-0.7.0-alpha.2.tgz",
    "effect": "4.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@softmax-universe/environment-tools": "https://github.com/softmax-universe/scott-demo-environments/releases/download/v0.7.0-alpha.2/softmax-universe-environment-tools-0.7.0-alpha.2.tgz",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.90.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@softmax-universe/compatible-models": "file:.local/runtime-packages/softmax-universe-compatible-models-0.7.0-alpha.2.tgz",
      "@softmax-universe/foundation": "file:.local/runtime-packages/softmax-universe-foundation-0.7.0-alpha.2.tgz",
      "@softmax-universe/local-cli": "file:.local/runtime-packages/softmax-universe-local-cli-0.7.0-alpha.2.tgz",
      "@softmax-universe/console": "file:.local/runtime-packages/softmax-universe-console-0.7.0-alpha.2.tgz",
      "@softmax-universe/runtime": "file:.local/runtime-packages/softmax-universe-runtime-0.7.0-alpha.2.tgz",
      "@softmax-universe/execution": "file:.local/runtime-packages/softmax-universe-execution-0.7.0-alpha.2.tgz",
      "@softmax-universe/inspector": "file:.local/runtime-packages/softmax-universe-inspector-0.7.0-alpha.2.tgz",
      "@softmax-universe/model-policy": "file:.local/runtime-packages/softmax-universe-model-policy-0.7.0-alpha.2.tgz",
      "@softmax-universe/orchestration": "file:.local/runtime-packages/softmax-universe-orchestration-0.7.0-alpha.2.tgz",
      "@softmax-universe/protocol": "file:.local/runtime-packages/softmax-universe-protocol-0.7.0-alpha.2.tgz",
      "@softmax-universe/runner": "file:.local/runtime-packages/softmax-universe-runner-0.7.0-alpha.2.tgz",
      "@softmax-universe/runtime-client": "file:.local/runtime-packages/softmax-universe-runtime-client-0.7.0-alpha.2.tgz",
      "@softmax-universe/sdk": "file:.local/runtime-packages/softmax-universe-sdk-0.7.0-alpha.2.tgz",
      "@softmax-universe/distribution": "file:.local/runtime-packages/softmax-universe-distribution-0.7.0-alpha.2.tgz",
      "@softmax-universe/installation": "file:.local/runtime-packages/softmax-universe-installation-0.7.0-alpha.2.tgz",
      "@softmax-universe/workbench": "file:.local/runtime-packages/softmax-universe-workbench-0.7.0-alpha.2.tgz",
      "@softmax-universe/environment-tools": "file:.local/runtime-packages/softmax-universe-environment-tools-0.7.0-alpha.2.tgz"
    }
  }
}
