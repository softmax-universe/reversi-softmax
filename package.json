{
  "name": "@softmax-universe/reversi-environment",
  "version": "0.1.0",
  "private": true,
  "description": "An independent Reversi game that records and benchmarks play with Softmax Universe.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && pnpm --filter @softmax-universe/reversi-game build && tsc -p tsconfig.json && node scripts/build.mjs",
    "type-check": "pnpm --filter @softmax-universe/reversi-game build && tsc -p tsconfig.json --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings app packages test scripts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "play": "node --import tsx app/view/play.ts",
    "benchmark": "node --import tsx app/benchmarks/command.ts",
    "universe": "universe",
    "build:app": "node scripts/build.mjs",
    "harbor:prepare": "node scripts/prepare-harbor.mjs",
    "harbor:verify": "node --import tsx app/benchmarks/harbor.ts",
    "local": "universe-local",
    "package:local": "node scripts/package.mjs",
    "package:game": "pnpm --filter @softmax-universe/reversi-game pack --pack-destination ./dist",
    "package:container": "node scripts/container.mjs"
  },
  "dependencies": {
    "@softmax-universe/console": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-console-0.4.0-alpha.1.tgz",
    "@softmax-universe/foundation": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-foundation-0.4.0-alpha.1.tgz",
    "@softmax-universe/inspector": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-inspector-0.4.0-alpha.1.tgz",
    "@softmax-universe/local-cli": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-local-cli-0.4.0-alpha.1.tgz",
    "@softmax-universe/model-policy": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-model-policy-0.4.0-alpha.1.tgz",
    "@softmax-universe/protocol": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-protocol-0.4.0-alpha.1.tgz",
    "@softmax-universe/reversi-game": "workspace:*",
    "@softmax-universe/runner": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-runner-0.4.0-alpha.1.tgz",
    "@softmax-universe/runtime": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-runtime-0.4.0-alpha.1.tgz",
    "@softmax-universe/runtime-client": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-runtime-client-0.4.0-alpha.1.tgz",
    "@softmax-universe/sdk": "https://github.com/softmax-universe/universe/releases/download/v0.4.0-alpha.1/softmax-universe-sdk-0.4.0-alpha.1.tgz",
    "effect": "4.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@10.33.2"
}
